# IBKR does not use an API key for the TWS/Gateway socket API.
# Log into IB Gateway manually, enable API socket access, then match these settings.
# Use a unique client id if another app, such as GQ Trader, is also connected.
IBKR_HOST=127.0.0.1
IBKR_PORT=4002
IBKR_CLIENT_ID=23

# EIA Open Data API key.
EIA_API_KEY=

# NOAA CDO token is optional. Open-Meteo does not require a key.
NOAA_CDO_TOKEN=

# Databento historical data key. Required only for licensed futures-price rebuilds.
DATABENTO_API_KEY=
